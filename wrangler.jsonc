{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temobay",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  // Next.js server code + node-postgres (Prisma adapter) need Node APIs.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // NextAuth নিজেই host যাচাই করে; Cloudflare-এর ডোমেইন থেকে আসা রিকোয়েস্ট
  // বিশ্বাসযোগ্য ঘোষণা না করলে UntrustedHost এরর হয়।
  "vars": {
    "AUTH_TRUST_HOST": "true"
  }
}
